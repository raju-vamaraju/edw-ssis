      DTS:CreationName=""
      DTS:DTSID="{589A0B97-D021-4A98-941F-5DD88E076A7A}"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="pRecTypeId_FinAcct">
      <DTS:VariableValue
        DTS:DataType="8"
        xml:space="preserve"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{8D9D8558-058F-4BD5-9693-54AF3EA17C3D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;&#xA;select &#xA;ABC.*&#xA;,B.ID&#xA;,B.ETL_RecordKey as Existing_ARNG_PROD&#xA;,B.External_id as Existing_Unique_External_Id&#xA;,PRD_K.ID as Product_SF_Key&#xA;,ACCT_K.ID as Person_ACCT_SF_KEY &#xA;, count(EDW_IP_ID) over (partition by ARNG_PROD) as ARNG_PROD_COUNT &#xA;from&#xA;(&#xA;&#x9;Select &#xA;&#x9;X.*&#xA;&#x9;,ltrim(rtrim(C.[EDW_IP_ID])) [EDW_IP_ID]&#xA;&#x9;,ltrim(rtrim(C.[IP_ROLE])) [IP_ROLE]&#xA;&#x9;--,ISNULL( CASE C.[IP_ROLE]  WHEN '' THEN NULL ELSE C.[IP_ROLE] END ,'OWNER') as [IP_ROLE]&#xA;&#x9;,ltrim(rtrim(C.[PD_REF_ID])) [PD_REF_ID]&#xA;&#x9;,case &#xA;                           when C.PD_REF_ID is not null or ltrim(rtrim(C.PD_REF_ID)) &lt;&gt; '' &#xA;                           then (ltrim(rtrim(X.EDW_AR_ID)) + '-'+ ltrim(rtrim(C.PD_REF_ID))) &#xA;                           else ltrim(rtrim(X.EDW_AR_ID)) &#xA;                   end as ARNG_PROD&#xA;&#x9;&#x9;&#x9;&#x9;   &#xA;&#x9;,case &#xA;                           when  C.EDW_IP_ID is not null or ltrim(rtrim(C.EDW_IP_ID)) &lt;&gt; '' &#xA;                           then (ltrim(rtrim(X.EDW_AR_ID)) + '-'+ ltrim(rtrim(C.EDW_IP_ID))) &#xA;                           else ltrim(rtrim(X.EDW_AR_ID)) &#xA;                   end as ARNG_PERACCT&#xA;&#xA;&#x9;from &#xA;&#x9;(&#xA;&#x9;&#x9;select &#xA;&#x9;&#x9;ltrim(rtrim(A.ACCT_LOOKUP_CD)) ACCT_LOOKUP_CD&#xA;&#x9;&#x9;,ltrim(rtrim(A.FNAME)) FNAME&#xA;&#x9;&#x9;,ltrim(rtrim(A.AR_NAME)) AR_NAME&#xA;&#x9;&#x9;,ltrim(rtrim(A.EDW_AR_ID)) EDW_AR_ID&#xA;&#x9;&#x9;,ltrim(rtrim(A.EDW_AR_SRC_STM)) EDW_AR_SRC_STM&#xA;&#x9;&#x9;,max(ltrim(rtrim(D.[PLAN_NAME]))) [PLAN_NAME]&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;from  &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_FIN_ACCTS]  A&#xA;&#x9;&#x9;&#x9;inner join &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_LINKAGES] C&#xA;&#x9;&#x9;&#x9;on ltrim(rtrim(A.EDW_AR_ID)) =ltrim(rtrim(C.EDW_AR_ID)) &#xA;&#x9;&#x9;&#x9;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_EMPLOYERS] D&#xA;&#x9;&#x9;&#x9;on ltrim(rtrim(C.[EDW_IP_ID])) = ltrim(rtrim(D.[EDW_IP_ID]))&#xA;&#xA;&#x9;&#x9;group by &#xA;&#x9;&#x9;A.ACCT_LOOKUP_CD&#xA;&#x9;&#x9;,A.AR_NAME&#xA;&#x9;&#x9;,A.EDW_AR_ID&#xA;&#x9;&#x9;,A.EDW_AR_SRC_STM&#xA;&#x9;&#x9;,A.FNAME&#xA;&#xA;&#x9;) X&#xA;&#xA;&#x9;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_LINKAGES] C&#xA;&#x9;on ltrim(rtrim(X.EDW_AR_ID)) =ltrim(rtrim(C.EDW_AR_ID)) &#xA;&#x9;where UPPER (trim(C.[IP_ROLE])) not in ( 'EMPLOYER' )&#xA;        -----          and C.PD_REF_ID is null&#xA;) ABC&#xA;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.[dbo].[TGT_EDW_FIN_ACCT_KEY] B&#xA;on &#xA;-- ltrim(rtrim(ABC.ARNG_PROD)) = ltrim(rtrim(B.ETL_RecordKey))&#xA;-- and &#xA;ltrim(rtrim(ABC.ARNG_PERACCT)) = ltrim(rtrim(B.External_id))&#xA;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.[dbo].[TGT_EDW_PRODUCTS_KEY] PRD_K&#xA;on ltrim(rtrim(ABC.[PD_REF_ID])) = ltrim(rtrim(PRD_K.[ETL_RecordKey]))&#xA;left join&#xA;(Select * from &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.[dbo].[TGT_EDW_PERSON_ACCT_KEY] &#xA;union &#xA;select * from &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.[dbo].[TGT_EDW_BUSINESS_ACCT_KEY]&#xA;)&#xA;ACCT_K&#xA;on ltrim(rtrim(ABC.[EDW_IP_ID])) = ltrim(rtrim(ACCT_K.[ETL_RecordKey]))&#xA;&#xA;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="vSQL">
      <DTS:VariableValue
        DTS:DataType="8">
select 
ABC.*
,B.ID
,B.ETL_RecordKey as Existing_ARNG_PROD
,B.External_id as Existing_Unique_External_Id
,PRD_K.ID as Product_SF_Key
,ACCT_K.ID as Person_ACCT_SF_KEY 
, count(EDW_IP_ID) over (partition by ARNG_PROD) as ARNG_PROD_COUNT 
from
(
	Select 
	X.*
	,ltrim(rtrim(C.[EDW_IP_ID])) [EDW_IP_ID]
	,ltrim(rtrim(C.[IP_ROLE])) [IP_ROLE]
	--,ISNULL( CASE C.[IP_ROLE]  WHEN '' THEN NULL ELSE C.[IP_ROLE] END ,'OWNER') as [IP_ROLE]
	,ltrim(rtrim(C.[PD_REF_ID])) [PD_REF_ID]
	,case 
                           when C.PD_REF_ID is not null or ltrim(rtrim(C.PD_REF_ID)) &lt;&gt; '' 
                           then (ltrim(rtrim(X.EDW_AR_ID)) + '-'+ ltrim(rtrim(C.PD_REF_ID))) 
                           else ltrim(rtrim(X.EDW_AR_ID)) 
                   end as ARNG_PROD
				   
	,case 
                           when  C.EDW_IP_ID is not null or ltrim(rtrim(C.EDW_IP_ID)) &lt;&gt; '' 
                           then (ltrim(rtrim(X.EDW_AR_ID)) + '-'+ ltrim(rtrim(C.EDW_IP_ID))) 
                           else ltrim(rtrim(X.EDW_AR_ID)) 
                   end as ARNG_PERACCT

	from 
	(
		select 
		ltrim(rtrim(A.ACCT_LOOKUP_CD)) ACCT_LOOKUP_CD
		,ltrim(rtrim(A.FNAME)) FNAME
		,ltrim(rtrim(A.AR_NAME)) AR_NAME
		,ltrim(rtrim(A.EDW_AR_ID)) EDW_AR_ID
		,ltrim(rtrim(A.EDW_AR_SRC_STM)) EDW_AR_SRC_STM
		,max(ltrim(rtrim(D.[PLAN_NAME]))) [PLAN_NAME]
		
		from  WEALTH_STG.[dbo].[STG_EDW_FIN_ACCTS]  A
			inner join WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
			on ltrim(rtrim(A.EDW_AR_ID)) =ltrim(rtrim(C.EDW_AR_ID)) 
			left join WEALTH_STG.[dbo].[STG_EDW_EMPLOYERS] D
			on ltrim(rtrim(C.[EDW_IP_ID])) = ltrim(rtrim(D.[EDW_IP_ID]))

		group by 
		A.ACCT_LOOKUP_CD
		,A.AR_NAME
		,A.EDW_AR_ID
		,A.EDW_AR_SRC_STM
		,A.FNAME

	) X

	left join WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
	on ltrim(rtrim(X.EDW_AR_ID)) =ltrim(rtrim(C.EDW_AR_ID)) 
	where UPPER (trim(C.[IP_ROLE])) not in ( 'EMPLOYER' )
        -----          and C.PD_REF_ID is null
) ABC
left join WEALTH_TGT.[dbo].[TGT_EDW_FIN_ACCT_KEY] B
on 
-- ltrim(rtrim(ABC.ARNG_PROD)) = ltrim(rtrim(B.ETL_RecordKey))
-- and 
ltrim(rtrim(ABC.ARNG_PERACCT)) = ltrim(rtrim(B.External_id))
left join WEALTH_TGT.[dbo].[TGT_EDW_PRODUCTS_KEY] PRD_K
on ltrim(rtrim(ABC.[PD_REF_ID])) = ltrim(rtrim(PRD_K.[ETL_RecordKey]))
left join
(Select * from WEALTH_TGT.[dbo].[TGT_EDW_PERSON_ACCT_KEY] 
union 
select * from WEALTH_TGT.[dbo].[TGT_EDW_BUSINESS_ACCT_KEY]
)
ACCT_K
on ltrim(rtrim(ABC.[EDW_IP_ID])) = ltrim(rtrim(ACCT_K.[ETL_RecordKey]))

</DTS:VariableValue>
    </DTS:Variable>
