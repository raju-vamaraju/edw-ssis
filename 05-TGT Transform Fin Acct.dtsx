                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Select * from
(
--- ### DELETE FROM ABOVE FOR TRANSFORM PACKAGE


select 
ABC.*
,B.ID
,B.ETL_RecordKey as key_ETL_RecordKey
,PRD_K.ID as Product_SF_Key
,ACCT_K.ID as Person_ACCT_SF_KEY 
from
(
	Select 
	X.*
	,C.[EDW_IP_ID]
	,C.[IP_ROLE]
	--,ISNULL( CASE C.[IP_ROLE]  WHEN '' THEN NULL ELSE C.[IP_ROLE] END ,'OWNER') as [IP_ROLE]
	,C.[PD_REF_ID]
	,case 
                           when C.PD_REF_ID is not null 
                           then (ltrim(rtrim(X.EDW_AR_ID)) + '-'+ ltrim(rtrim(C.PD_REF_ID))) 
                           else ltrim(rtrim(X.EDW_AR_ID)) 
                   end as ARNG_PROD

	from 
	(
		select 
		 A.ACCT_LOOKUP_CD
		,A.AR_NAME
		,A.EDW_AR_ID
		,A.EDW_AR_SRC_STM
		,max(D.[PLAN_NAME]) [PLAN_NAME]
		
		from  SIT_WEALTH_STG.[dbo].[STG_EDW_FIN_ACCTS]  A
			inner join SIT_WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
			on A.EDW_AR_ID =C.EDW_AR_ID 
			left join SIT_WEALTH_STG.[dbo].[STG_EDW_EMPLOYERS] D
			on C.[EDW_IP_ID] = D.[EDW_IP_ID]
		
		group by 
		A.ACCT_LOOKUP_CD
		,A.AR_NAME
		,A.EDW_AR_ID
		,A.EDW_AR_SRC_STM

	) X

	left join SIT_WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
	on X.EDW_AR_ID =C.EDW_AR_ID 
	where UPPER (trim(C.[IP_ROLE])) not in ( 'EMPLOYER' )
        -----          and C.PD_REF_ID is null
) ABC
left join SIT_WEALTH_TGT.[dbo].[TGT_EDW_FIN_ACCT_KEY] B
on ABC.ARNG_PROD = B.ETL_RecordKey
left join SIT_WEALTH_TGT.[dbo].[TGT_EDW_PRODUCTS_KEY] PRD_K
on ABC.[PD_REF_ID] = PRD_K.[ETL_RecordKey]
left join
(Select * from SIT_WEALTH_TGT.[dbo].[TGT_EDW_PERSON_ACCT_KEY] 
union 
select * from SIT_WEALTH_TGT.[dbo].[TGT_EDW_BUSINESS_ACCT_KEY]
)
ACCT_K
on ABC.[EDW_IP_ID] = ACCT_K.[ETL_RecordKey]




--- ###### DELETE from below for transform pkg

) Try
where EDW_IP_ID in
(
select top(200000) EDW_IP_ID from
(
select 
EXTRACT_FG,
EDW_IP_ID,
EDW_IP_SRC_STM,
SRC_IP_ID,
PARTY_TYPE,
PARTY_NAME,
SALUTATION,
GIVEN_NAME,
MIDDLE_NAME,
LAST_NAME,
MAILING_ADDRESS,
MAILING_COUNTRY,
PRIMARY_PHONE,
PRIMARY_PHONE_TYPE,
EMAIL_ADDRESS,
B.ID
from (
select *  from SIT_WEALTH_STG.[dbo].[STG_EDW_PERSON_ACCT]  
union all
select *  from SIT_WEALTH_STG.[dbo].[STG_EDW_BUSINESS_ACCT]
)A  
left join SIT_WEALTH_TGT.dbo.TGT_EDW_PERSON_ACCT_KEY B

on A.EDW_IP_ID = B.ETL_RecordKey

---- delete from below --- 
where A.EDW_IP_ID in

(Select 
	distinct C.[EDW_IP_ID]
	

	from 
	(
		select 
		 A.ACCT_LOOKUP_CD
		,A.AR_NAME
		,A.EDW_AR_ID
		,A.EDW_AR_SRC_STM
		,max(D.[PLAN_NAME]) [PLAN_NAME]
		
		from SIT_WEALTH_STG.[dbo].[STG_EDW_FIN_ACCTS]  A
			inner join SIT_WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
			on A.EDW_AR_ID =C.EDW_AR_ID 
			left join SIT_WEALTH_STG.[dbo].[STG_EDW_EMPLOYERS] D
			on C.[EDW_IP_ID] = D.[EDW_IP_ID]
		where A.EDW_AR_ID = 10038862
		group by 
		A.ACCT_LOOKUP_CD
		,A.AR_NAME
		,A.EDW_AR_ID
		,A.EDW_AR_SRC_STM

	) X

	left join SIT_WEALTH_STG.[dbo].[STG_EDW_LINKAGES] C
	on X.EDW_AR_ID =C.EDW_AR_ID 
	where UPPER (trim(C.[IP_ROLE])) not in ( 'EMPLOYER' )
	)
) ABC
	
	order by EDW_IP_ID desc
) 

