      DTS:Namespace="User"
      DTS:ObjectName="vSQL">
      <DTS:VariableValue
        DTS:DataType="8">select A.*, B.Id as RecordTypeId
from WEALTH_TGT.[dbo].[TGT_EDW_FIN_ACCT] A
left join WEALTH_STG.[dbo].[STG_SF_RECORD_TYPE] B
on upper(ltrim(rtrim(A.RecordType))) = upper(ltrim(rtrim(B.Name)))</DTS:VariableValue>
    </DTS:Variable>
