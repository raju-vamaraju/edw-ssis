      DTS:Expression="&quot;select A.*, B.Id as RecordTypeId&#xA;from &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.[dbo].[TGT_EDW_FIN_ACCT] A&#xA;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_SF_RECORD_TYPE] B&#xA;on upper(ltrim(rtrim(A.RecordType))) = upper(ltrim(rtrim(B.Name)))&quot;"
