  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Copy file from S3 to D Temp"
      DTS:CreationName="PragmaticWorks.TaskFactory.Tasks.PowerShell"
      DTS:Description="TF PowerShell Task"
      DTS:DTSID="{2B2A38EA-3E2A-4105-9024-D4AEFA810A70}"
      DTS:ExecutableType="PragmaticWorks.TaskFactory.Tasks.PowerShell"
      DTS:LocaleID="-1"
      DTS:ObjectName="Copy file from S3 to D Temp"
      DTS:TaskContact="TF PowerShell Task;SQL Sentry, LLC; Task Factory (c) 2009 - 2019; https://www.sentryone.com;support@sentryone.com"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <PowerShellTask
          Script="$env:no_proxy = &quot;169.254.169.254,localhost, s3.ap-southeast-2.amazonaws.com&quot;&#xA;&#xA;Remove-Item D:\EDW_latest_Unzipped\*.* -ErrorAction Ignore&#xA;&#xA;#Remove-Item D:\temp\EDW_Source_File\edw_latest.zip -ErrorAction Ignore&#xA;&#xA;#aws s3 cp s3://lz140nonprod-engineering-edw-inbound/edw_latest.zip D:\temp\EDW_Source_File\ -ErrorAction Ignore&#xA;&#xA;&#xA;Expand-Archive -Force D:\temp\EDW_Source_File\edw_latest.Zip D:\EDW_latest_Unzipped&#xA;&#xA;#Expand-Archive -Force 'D:\temp\EDW_Source_File\edw_latest.Zip' 'D:\EDW_latest_Unzipped\'&#xA;&#xA;&#xA;#powershell -command &quot;Expand-Archive -Force 'D:\temp\EDW_Source_File\edw_latest.Zip' 'D:\EDW_latest_Unzipped\'&quot;&#xA;&#xA;#aws s3 rm s3://lz140nonprod-engineering-edw-inbound/edw_latest.zip"
          ResultsVariable="" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Copy file to S3"
      DTS:CreationName="PragmaticWorks.TaskFactory.Tasks.PowerShell"
      DTS:Description="TF PowerShell Task"
      DTS:Disabled="True"
      DTS:DTSID="{2BE56606-D419-40B5-9D5E-E6C3BE754153}"
      DTS:ExecutableType="PragmaticWorks.TaskFactory.Tasks.PowerShell"
      DTS:LocaleID="-1"
      DTS:ObjectName="Copy file to S3"
      DTS:TaskContact="TF PowerShell Task;SQL Sentry, LLC; Task Factory (c) 2009 - 2019; https://www.sentryone.com;support@sentryone.com"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <PowerShellTask
          Script="$env:no_proxy = &quot;169.254.169.254,localhost, s3.ap-southeast-2.amazonaws.com&quot;&#xA;aws s3 cp D:\temp\edw_latest.zip s3://lz140nonprod-engineering-edw-inbound/edw_latest.zip --sse aws:kms --sse-kms-key-id 5311f1c8-ae3d-4e7d-acbf-86ea6186b3b8"
          ResultsVariable="" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
