      DTS:CreationName=""
      DTS:DTSID="{23CC1D45-F325-4D88-82E4-2FCDA8A5E94C}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select &#xA;FNAME,&#xA;PD_REF_ID,&#xA;EDW_AR_SRC_STM,&#xA;AR_SRC_PD_CD,&#xA;AR_SRC_PD_NAME,&#xA;AR_TGT_PD_CD,&#xA;AR_TGT_PD_NAME,&#xA;PROD_ISR,&#xA;PROD_FMLY,&#xA;ENTITY,&#xA;PROD_AREA,&#xA;OP_RESP,&#xA;FUND,&#xA;B.ID&#xA;from &quot;+ (DT_WSTR, 20) @[User::vSTG_DB]&#xA;+&quot;.[dbo].[STG_EDW_PRODUCTS]  A&#xA;left join &quot;+&#xA;&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.dbo.TGT_EDW_PRODUCTS_KEY B&#xA;&#xA;on A.PD_REF_ID = B.ETL_RecordKey&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="vSQL">
      <DTS:VariableValue
        DTS:DataType="8">select 
FNAME,
PD_REF_ID,
EDW_AR_SRC_STM,
AR_SRC_PD_CD,
AR_SRC_PD_NAME,
AR_TGT_PD_CD,
AR_TGT_PD_NAME,
PROD_ISR,
PROD_FMLY,
ENTITY,
PROD_AREA,
OP_RESP,
FUND,
B.ID
from WEALTH_STG.[dbo].[STG_EDW_PRODUCTS]  A
left join WEALTH_TGT.dbo.TGT_EDW_PRODUCTS_KEY B

on A.PD_REF_ID = B.ETL_RecordKey</DTS:VariableValue>
    </DTS:Variable>
