                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT LTRIM(RTRIM([EXTRACT_FG])) as [EXTRACT_FG]
      ,LTRIM(RTRIM([EDW_IP_ID])) as [EDW_IP_ID]
      ,LTRIM(RTRIM([EDW_IP_SRC_STM])) as [EDW_IP_SRC_STM]
      ,LTRIM(RTRIM([SRC_IP_ID])) as [SRC_IP_ID]
      ,LTRIM(RTRIM([PARTY_TYPE])) as [PARTY_TYPE]
      ,LTRIM(RTRIM([PARTY_NAME])) as [PARTY_NAME]
      ,LTRIM(RTRIM([SALUTATION])) as [SALUTATION]
      ,LTRIM(RTRIM([GIVEN_NAME])) as [GIVEN_NAME]
      ,LTRIM(RTRIM([MIDDLE_NAME])) as [MIDDLE_NAME]
      ,LTRIM(RTRIM([LAST_NAME])) as [LAST_NAME]
      ,LTRIM(RTRIM([MAILING_ADDRESS])) as [MAILING_ADDRESS]
      ,LTRIM(RTRIM([MAILING_COUNTRY])) as [MAILING_COUNTRY]
      ,LTRIM(RTRIM([PRIMARY_PHONE])) as [PRIMARY_PHONE]
      ,LTRIM(RTRIM([PRIMARY_PHONE_TYPE])) as [PRIMARY_PHONE_TYPE],
ltrim(rtrim([EMAIL_ADDRESS])) AS [EMAIL_ADDRESS],
ltrim(rtrim([GENDER])) AS [GENDER],
ltrim(rtrim([BIRTHDATE])) AS [BIRTHDATE],
-- NOTE: REPLACE(CHAR(13)/CHAR(10)) must always be on the LAST column only.
-- This strips the row terminator (CRLF) that bleeds into the final 
-- column value when SSIS loads the fixed-width flat file.
-- If a new column is added after POSTCODE, move this REPLACE to that column.
     ltrim(rtrim(REPLACE(REPLACE([POSTCODE], CHAR(13), ''), CHAR(10), '') )) AS [POSTCODE]
,LTRIM(RTRIM([FNAME])) as [FNAME]
  FROM [dbo].[LND_EDW_ACCOUNTS]</property>
