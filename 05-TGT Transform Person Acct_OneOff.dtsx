    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{29DD3ACF-D998-4826-BB7E-F53A7FA5B5AA}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select &#xA; A.FNAME, A.EXTRACT_FG,&#xA;A.EDW_IP_ID,&#xA;A.EDW_IP_SRC_STM,&#xA;A.SRC_IP_ID,&#xA;A.PARTY_TYPE,&#xA;A.PARTY_NAME,&#xA;A.SALUTATION,&#xA;A.GIVEN_NAME,&#xA;A.MIDDLE_NAME,&#xA;A.LAST_NAME,&#xA;A.MAILING_ADDRESS,&#xA;A.MAILING_COUNTRY,&#xA;A.PRIMARY_PHONE,&#xA;A.PRIMARY_PHONE_TYPE,&#xA;A.EMAIL_ADDRESS,&#xA;CAST(CASE &#xA;    WHEN LTRIM(RTRIM(A.GENDER)) IS NULL              THEN NULL&#xA;    WHEN LTRIM(RTRIM(A.GENDER)) = ''                 THEN NULL&#xA;    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'M'         THEN 'Male'&#xA;    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'MALE'      THEN 'Male'&#xA;    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'F'         THEN 'Female'&#xA;    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'FEMALE'    THEN 'Female'&#xA;    ELSE                                              'Other'&#xA;END AS NVARCHAR(50)) AS GENDER,&#xA;TRY_CONVERT(DATE, NULLIF(LTRIM(RTRIM(A.BIRTHDATE)), ''), 103) AS BIRTHDATE,&#xA;CAST(CASE &#xA;&#x9;WHEN LEN(LTRIM(RTRIM(A.POSTCODE))) = 4         THEN A.POSTCODE&#xA;    ELSE                                              '9999'&#xA;END AS NVARCHAR(257)) AS POSTCODE,&#xA;B.ID&#xA;from &quot;+&#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_PERSON_ACCT_ONEOFF] A&#xA;left join &quot;+&#xA;(DT_WSTR, 20) @[User::vTGT_DB]+&quot;.dbo.TGT_EDW_PERSON_ACCT_KEY B&#xA;on A.EDW_IP_ID = B.ETL_RecordKey&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="vSQL">
      <DTS:VariableValue
        DTS:DataType="8">select 
 A.FNAME, A.EXTRACT_FG,
A.EDW_IP_ID,
A.EDW_IP_SRC_STM,
A.SRC_IP_ID,
A.PARTY_TYPE,
A.PARTY_NAME,
A.SALUTATION,
A.GIVEN_NAME,
A.MIDDLE_NAME,
A.LAST_NAME,
A.MAILING_ADDRESS,
A.MAILING_COUNTRY,
A.PRIMARY_PHONE,
A.PRIMARY_PHONE_TYPE,
A.EMAIL_ADDRESS,
CAST(CASE 
    WHEN LTRIM(RTRIM(A.GENDER)) IS NULL              THEN NULL
    WHEN LTRIM(RTRIM(A.GENDER)) = ''                 THEN NULL
    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'M'         THEN 'Male'
    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'MALE'      THEN 'Male'
    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'F'         THEN 'Female'
    WHEN UPPER(LTRIM(RTRIM(A.GENDER))) = 'FEMALE'    THEN 'Female'
    ELSE                                              'Other'
END AS NVARCHAR(50)) AS GENDER,
TRY_CONVERT(DATE, NULLIF(LTRIM(RTRIM(A.BIRTHDATE)), ''), 103) AS BIRTHDATE,
CAST(CASE 
	WHEN LEN(LTRIM(RTRIM(A.POSTCODE))) = 4         THEN A.POSTCODE
    ELSE                                              '9999'
END AS NVARCHAR(257)) AS POSTCODE,
B.ID
from WEALTH_STG.[dbo].[STG_EDW_PERSON_ACCT_ONEOFF] A
left join WEALTH_TGT.dbo.TGT_EDW_PERSON_ACCT_KEY B
on A.EDW_IP_ID = B.ETL_RecordKey</DTS:VariableValue>
    </DTS:Variable>
