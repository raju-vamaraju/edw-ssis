    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{39A91544-FEEF-42EC-B2E7-1A1B347F0FB9}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT   &#xA;ltrim(rtrim(A.FNAME)) as FNAME,  &#xA;ltrim(rtrim(A.EXTRACT_FG)) as EXTRACT_FG&#xA;,ltrim(rtrim(A.[EDW_AR_ID])) as EDW_AR_ID&#xA;,ltrim(rtrim(A.[EDW_IP_ID]))  as LND_EDW_IP_ID&#xA;,ltrim(rtrim(A.IP_ROLE)) as IP_ROLE&#xA;,ltrim(rtrim(REPLACE(REPLACE(PD_REF_ID, CHAR(13), ''), CHAR(10), '') )) as PD_REF_ID&#xA;--,isnull(B.[EDW_IP_ID],'Y')  as LINK_EDW_IP_ID&#xA;,case &#xA;                           when ltrim(rtrim(B.EDW_IP_ID)) =''  or ltrim(rtrim(B.EDW_IP_ID)) is null&#xA;                           then 'Y'&#xA;                           else ltrim(rtrim(B.EDW_IP_ID))&#xA;                   end as LINK_EDW_IP_ID&#xA;&#xA;--,isnull(B.EDW_AR_ID,'Y')  as LINK_EDW_AR_ID&#xA;&#xA;,case &#xA;                           when ltrim(rtrim(B.EDW_AR_ID)) =''  or ltrim(rtrim(B.EDW_AR_ID)) is null&#xA;                           then 'Y'&#xA;                           else ltrim(rtrim(B.EDW_AR_ID))&#xA;                   end as LINK_EDW_AR_ID&#xA;&#xA;&#xA;FROM &quot; &#xA;&#x9;+&#xA;&#x9;&#x9;(DT_WSTR, 20) @[User::vLND_DB]+&quot;.[dbo].[LND_EDW_LINKAGES] A&#xA;left join &quot;+&#xA; &#xA;(DT_WSTR, 20) @[User::vSTG_DB]+&quot;.[dbo].[STG_EDW_LNK_FIN_ACCT_EMP_IP_IDS] B&#xA;&#xA; on ltrim(rtrim(A.[EDW_AR_ID])) = ltrim(rtrim(B.[EDW_AR_ID]))&#xA;and ltrim(rtrim(A.[EDW_IP_ID])) = ltrim(rtrim(B.[EDW_IP_ID]))&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_SQL">
      <DTS:VariableValue
        DTS:DataType="8">SELECT   
ltrim(rtrim(A.FNAME)) as FNAME,  
ltrim(rtrim(A.EXTRACT_FG)) as EXTRACT_FG
,ltrim(rtrim(A.[EDW_AR_ID])) as EDW_AR_ID
,ltrim(rtrim(A.[EDW_IP_ID]))  as LND_EDW_IP_ID
,ltrim(rtrim(A.IP_ROLE)) as IP_ROLE
,ltrim(rtrim(REPLACE(REPLACE(PD_REF_ID, CHAR(13), ''), CHAR(10), '') )) as PD_REF_ID
--,isnull(B.[EDW_IP_ID],'Y')  as LINK_EDW_IP_ID
,case 
                           when ltrim(rtrim(B.EDW_IP_ID)) =''  or ltrim(rtrim(B.EDW_IP_ID)) is null
                           then 'Y'
                           else ltrim(rtrim(B.EDW_IP_ID))
                   end as LINK_EDW_IP_ID

--,isnull(B.EDW_AR_ID,'Y')  as LINK_EDW_AR_ID

,case 
                           when ltrim(rtrim(B.EDW_AR_ID)) =''  or ltrim(rtrim(B.EDW_AR_ID)) is null
                           then 'Y'
                           else ltrim(rtrim(B.EDW_AR_ID))
                   end as LINK_EDW_AR_ID


FROM WEALTH_LND.[dbo].[LND_EDW_LINKAGES] A
left join WEALTH_STG.[dbo].[STG_EDW_LNK_FIN_ACCT_EMP_IP_IDS] B

 on ltrim(rtrim(A.[EDW_AR_ID])) = ltrim(rtrim(B.[EDW_AR_ID]))
and ltrim(rtrim(A.[EDW_IP_ID])) = ltrim(rtrim(B.[EDW_IP_ID]))</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
