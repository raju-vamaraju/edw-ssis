                      name="ACCT_LOOKUP_CD"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Load STG EDW Fin Acct Prep\LND EDW Fin Acct.Outputs[OLE DB Source Output].Columns[EDW_AR_ID]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
