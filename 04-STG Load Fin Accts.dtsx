      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          autoAdjustBufferSize="true"
          defaultBufferMaxRows="50000"
          defaultBufferSize="50485760"
          version="1">
          <components>
            <component
              refId="Package\Load STG EDW Fin Acct Prep\LND EDW Fin Acct"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="LND EDW Fin Acct"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[LND_EDW_FIN_ACCTS]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	ltrim(rtrim(A.[EXTRACT_FG])) as [EXTRACT_FG]
	,ltrim(rtrim(A.ACCT_LOOKUP_CD)) as [ACCT_LOOKUP_CD]
	,ltrim(rtrim(A.AR_NAME)) as [AR_NAME]
	,ltrim(rtrim(A.EDW_AR_ID)) as [EDW_AR_ID]
	,ltrim(rtrim(REPLACE(REPLACE(A.EDW_AR_SRC_STM, CHAR(13), ''), CHAR(10), '') )) AS [EDW_AR_SRC_STM]
	, B.PD_REF_ID
	, isnull(B.LNK_EDW_AR_ID,'N') IS_MK_PRODUCT
	, B.NEW_MK_PROD_ARNG
   
FROM 
		[WEALTH_LND].[dbo].[LND_EDW_FIN_ACCTS] A

	left Join

	  (
		select 
			  LNK.PD_REF_ID
			, LNK.BUSS_IP_ID
			, LNK.EDW_AR_ID as LNK_EDW_AR_ID
			, isnull(MK_PRODUCT.EDW_IP_ID,'Y') as NEW_MK_PROD_ARNG
		from
			( 
			 select ('S'+ EDW_AR_ID) as BUSS_IP_ID, EDW_AR_ID, PD_REF_ID from
			 [WEALTH_STG].[dbo].[STG_EDW_LINKAGES] 
			 ) LNK
		left join
		    [WEALTH_STG].[dbo].[STG_EDW_MK_PROD_BUS_IP_IDS]  MK_PRODUCT
		on ltrim(rtrim(LNK.BUSS_IP_ID))  = ltrim(rtrim(MK_PRODUCT.EDW_IP_ID))
		where LNK.PD_REF_ID in ('1','2','3','4')
	  )B

  on ltrim(rtrim(A.EDW_AR_ID)) = ltrim(rtrim(B.LNK_EDW_AR_ID))</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable">User::v_SQL</property>
                <property
