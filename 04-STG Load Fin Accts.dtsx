                          expressionType="Notify"
                          name="FriendlyExpression">UPPER(TRIM(LEFT(AR_NAME,13))) == "MKEY INV SER-" ? RTRIM(LTRIM(SUBSTRING(AR_NAME,14,40))) : AR_NAME</property>
