                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[UPPER]([TRIM]([LEFT](#{Package\IS_MK_Product_Insert 1\STG EDW Fin Acct Prep.Outputs[OLE DB Source Output].Columns[AR_NAME]},13))) == "MKEY INV SER-" ? [RTRIM]([LTRIM]([SUBSTRING](#{Package\IS_MK_Product_Insert 1\STG EDW Fin Acct Prep.Outputs[OLE DB Source Output].Columns[AR_NAME]},14,40))) : #{Package\IS_MK_Product_Insert 1\STG EDW Fin Acct Prep.Outputs[OLE DB Source Output].Columns[AR_NAME]}</property>
