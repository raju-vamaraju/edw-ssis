          SQLTask:SqlStatementSource="MERGE [dbo].[STG_EDW_LINKAGES] T&#xA;USING [dbo].[STG_EDW_MK_BUSACCT_LINK_UPDT] S ON T.[EDW_AR_ID]=S.[EDW_AR_ID]&#xA;WHEN MATCHED THEN&#xA;UPDATE SET [EDW_IP_ID]=S.[EDW_IP_ID], IP_ROLE = S.[IP_ROLE];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
