    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{6ED12416-6A3D-47A1-B9FE-6B20F3795A0D}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT ltrim(rtrim(A.[FNAME])) as [FNAME]&#xA;&#x9;,&#xA;&#x9;ltrim(rtrim(A.[EXTRACT_FG])) as [EXTRACT_FG]&#xA;&#x9;,ltrim(rtrim(A.ACCT_LOOKUP_CD)) as [ACCT_LOOKUP_CD]&#xA;&#x9;,ltrim(rtrim(A.AR_NAME)) as [AR_NAME]&#xA;&#x9;,ltrim(rtrim(A.EDW_AR_ID)) as [EDW_AR_ID]&#xA;&#x9;,ltrim(rtrim(REPLACE(REPLACE(A.EDW_AR_SRC_STM, CHAR(13), ''), CHAR(10), '') )) AS [EDW_AR_SRC_STM]&#xA;&#x9;, B.PD_REF_ID&#xA;&#x9;, isnull(B.LNK_EDW_AR_ID,'N') IS_MK_PRODUCT&#xA;&#x9;, B.NEW_MK_PROD_ARNG&#xA;   &#xA;FROM &quot;+&#xA;&#x9;&#x9;(DT_WSTR, 20) @[User::vLND_DB]+&quot;.[dbo].[LND_EDW_FIN_ACCTS] A&#xA;&#xA;&#x9;left Join&#xA;&#xA;&#x9;  (&#xA;&#x9;&#x9;select &#xA;&#x9;&#x9;&#x9;  LNK.PD_REF_ID&#xA;&#x9;&#x9;&#x9;, LNK.BUSS_IP_ID&#xA;&#x9;&#x9;&#x9;, LNK.EDW_AR_ID as LNK_EDW_AR_ID&#xA;&#x9;&#x9;&#x9;, isnull(MK_PRODUCT.EDW_IP_ID,'Y') as NEW_MK_PROD_ARNG&#xA;&#x9;&#x9;from&#xA;&#x9;&#x9;&#x9;( &#xA;&#x9;&#x9;&#x9; select ('S'+ EDW_AR_ID) as BUSS_IP_ID, EDW_AR_ID, PD_REF_ID from &quot; +&#xA;&#x9;&#x9;&#x9; (DT_WSTR, 20) @[User::vSTG_DB] +&quot;.[dbo].[STG_EDW_LINKAGES] &#xA;&#x9;&#x9;&#x9; ) LNK&#xA;&#x9;&#x9;left join &quot; +&#xA;&#x9;&#x9;    (DT_WSTR, 20) @[User::vSTG_DB] +&quot;.[dbo].[STG_EDW_MK_PROD_BUS_IP_IDS]  MK_PRODUCT&#xA;&#x9;&#x9;on ltrim(rtrim(LNK.BUSS_IP_ID))  = ltrim(rtrim(MK_PRODUCT.EDW_IP_ID))&#xA;&#x9;&#x9;where LNK.PD_REF_ID in ('1','2','3','4')&#xA;&#x9;  )B&#xA;&#xA;  on ltrim(rtrim(A.EDW_AR_ID)) = ltrim(rtrim(B.LNK_EDW_AR_ID))&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_SQL">
      <DTS:VariableValue
        DTS:DataType="8">SELECT ltrim(rtrim(A.[FNAME])) as [FNAME]
	,
	ltrim(rtrim(A.[EXTRACT_FG])) as [EXTRACT_FG]
	,ltrim(rtrim(A.ACCT_LOOKUP_CD)) as [ACCT_LOOKUP_CD]
	,ltrim(rtrim(A.AR_NAME)) as [AR_NAME]
	,ltrim(rtrim(A.EDW_AR_ID)) as [EDW_AR_ID]
	,ltrim(rtrim(REPLACE(REPLACE(A.EDW_AR_SRC_STM, CHAR(13), ''), CHAR(10), '') )) AS [EDW_AR_SRC_STM]
	, B.PD_REF_ID
	, isnull(B.LNK_EDW_AR_ID,'N') IS_MK_PRODUCT
	, B.NEW_MK_PROD_ARNG
   
FROM WEALTH_LND.[dbo].[LND_EDW_FIN_ACCTS] A

	left Join

	  (
		select 
			  LNK.PD_REF_ID
			, LNK.BUSS_IP_ID
			, LNK.EDW_AR_ID as LNK_EDW_AR_ID
			, isnull(MK_PRODUCT.EDW_IP_ID,'Y') as NEW_MK_PROD_ARNG
		from
			( 
			 select ('S'+ EDW_AR_ID) as BUSS_IP_ID, EDW_AR_ID, PD_REF_ID from WEALTH_STG.[dbo].[STG_EDW_LINKAGES] 
			 ) LNK
		left join WEALTH_STG.[dbo].[STG_EDW_MK_PROD_BUS_IP_IDS]  MK_PRODUCT
		on ltrim(rtrim(LNK.BUSS_IP_ID))  = ltrim(rtrim(MK_PRODUCT.EDW_IP_ID))
		where LNK.PD_REF_ID in ('1','2','3','4')
	  )B

  on ltrim(rtrim(A.EDW_AR_ID)) = ltrim(rtrim(B.LNK_EDW_AR_ID))</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
