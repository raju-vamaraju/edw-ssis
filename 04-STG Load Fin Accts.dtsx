                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Load STG EDW Fin Acct Prep\LND EDW Fin Acct.Outputs[OLE DB Source Output].ExternalColumns[ACCT_LOOKUP_CD]"
                      length="300"
