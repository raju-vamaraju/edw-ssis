                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Load STG EDW Fin Acct Prep\LND EDW Fin Acct.Outputs[OLE DB Source Output].ExternalColumns[AR_NAME]"
                      length="300"
