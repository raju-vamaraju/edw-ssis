      ,ltrim(rtrim([AR_TGT_PD_NAME])) as AR_TGT_PD_NAME
      ,ltrim(rtrim([PROD_ISR])) as PROD_ISR
      ,ltrim(rtrim([PROD_FMLY])) as PROD_FMLY
      ,ltrim(rtrim([ENTITY])) as ENTITY
      ,ltrim(rtrim([PROD_AREA])) as PROD_AREA
      ,ltrim(rtrim([OP_RESP])) as OP_RESP
      ,ltrim(rtrim(REPLACE(REPLACE([FUND], CHAR(13), ''), CHAR(10), '') )) as FUND
     FROM [dbo].[LND_EDW_PRODUCTS]</property>
