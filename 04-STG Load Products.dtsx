                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/****** Script for SelectTopNRows command from SSMS  ******/
SELECT 
ltrim(rtrim([FNAME])) as FNAME
,ltrim(rtrim([EXTRACT_FG])) as EXTRACT_FG
      ,ltrim(rtrim([PD_REF_ID])) as PD_REF_ID
      ,ltrim(rtrim([EDW_AR_SRC_STM])) as EDW_AR_SRC_STM
