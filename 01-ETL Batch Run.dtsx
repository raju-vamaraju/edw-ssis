        <SQLTask:SqlTaskData
          SQLTask:Connection="{CAEB46AA-F33A-4C72-8C4E-AC3027F4426E}"
          SQLTask:SqlStatementSource="execute ETL_Start_Batch_SP ?, ?, ?;&#xA;&#xA;select r.Run_Id, r.Status_Code as Run_Type, d.Current_Delta_Datetime, b.Source_System_Code&#xA;from ETL_Batch_Run r&#xA;inner join ETL_Batch b on (b.Batch_Id = r.Batch_Id)&#xA;inner join ETL_Batch_Delta_State d on (d.Batch_Id = b.Batch_Id)&#xA;where r.Run_Id in (select max(r2.Run_Id) from ETL_Batch_Run r2&#xA;  inner join ETL_Batch b on(b.Batch_Id = r2.Batch_Id and b.Batch_Name = ?))"
