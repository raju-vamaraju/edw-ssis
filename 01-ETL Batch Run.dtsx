    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{94111939-C224-44A5-807D-A364E00529FE}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select p.Run_Flag &#xA;from ETL_Batch_Package p &#xA;join ETL_Batch b on (b.batch_id = p.batch_id)&#xA; where b.batch_name = '&quot; + @[$Package::pBatchName] + &quot;' and p.run_sequence = &quot; + (DT_WSTR,12)@[User::vRunSequence]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="vSQLCheckRunFlag">
      <DTS:VariableValue
        DTS:DataType="8">select p.Run_Flag 
from ETL_Batch_Package p 
join ETL_Batch b on (b.batch_id = p.batch_id)
 where b.batch_name = 'Salesforce EDW Data Migration' and p.run_sequence = 0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AA9C4F4A-E158-43C2-9FDA-A969837B6758}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;select p.Run_Sequence, p.Execution_Type, p.Execution_Platform, isnull(p.package1_name,'') as Package1Name, isnull(p.package2_name,'') as Package2Name, isnull(p.package3_name,'') as Package3Name, isnull(p.package4_name,'')as Package4Name, p.Folder_Name, p.Project_Name &#xA;from ETL_Batch_Package p&#xA;join ETL_Batch b on (b.batch_id = p.batch_id)&#xA; where b.batch_name = '&quot; + @[$Package::pBatchName] + &#xA;&quot;' order by p.run_sequence&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="vSQLSource">
      <DTS:VariableValue
        DTS:DataType="8">select p.Run_Sequence, p.Execution_Type, p.Execution_Platform, isnull(p.package1_name,'') as Package1Name, isnull(p.package2_name,'') as Package2Name, isnull(p.package3_name,'') as Package3Name, isnull(p.package4_name,'')as Package4Name, p.Folder_Name, p.Project_Name 
from ETL_Batch_Package p
join ETL_Batch b on (b.batch_id = p.batch_id)
 where b.batch_name = 'Salesforce EDW Data Migration' order by p.run_sequence</DTS:VariableValue>
    </DTS:Variable>
