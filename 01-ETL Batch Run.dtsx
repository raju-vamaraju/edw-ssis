            </DTS:Executable>
            <DTS:Executable
              DTS:refId="Package\Sequence Container\Foreach Loop Container\End Batch Run Fail"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{F1FDA5CE-9D7D-45E0-A66E-0F1F4774FEDF}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
