      <DTS:PropertyExpression
        DTS:Name="FromLine">@[$Project::pSMTP_EmailSender]</DTS:PropertyExpression>
      <DTS:PropertyExpression
        DTS:Name="Subject">@[$Project::pEnvironment]  + " " + @[$Package::pBatchName] + " has FAILED"</DTS:PropertyExpression>
      <DTS:PropertyExpression
