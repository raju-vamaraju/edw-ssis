    <DTS:Executable
      DTS:refId="Package\Send Email Batch Sucess"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{653D4A35-3442-4693-8943-65FD8EA215C3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Send Email Batch Sucess"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A1098A42-BD8A-44E7-ABBF-EE2C3CEC348D}"
          SQLTask:SqlStatementSource="DECLARE @Table NVARCHAR(MAX)&#xA;&#xA;DECLARE @body NVARCHAR(MAX)&#xA;&#xA;DECLARE @emailrecipients as NVARCHAR(MAX);&#xA;SET @emailrecipients = ?;&#xA;&#xA;DECLARE @attachments as NVARCHAR(MAX);&#xA;&#xA;SET @attachments = 'D:\Wealth_SalesForce_Data_Migration\CRM_Complaints\Audit_Files\SF_EDW_PersonAcct_Audit.csv;D:\Wealth_SalesForce_Data_Migration\CRM_Complaints\Audit_Files\SF_EDW_BusinessAcct_Audit.csv;D:\Wealth_SalesForce_Data_Migration\CRM_Complaints\Audit_Files\SF_EDW_FinAcct_Audit.csv;D:\Wealth_SalesForce_Data_Migration\CRM_Complaints\Audit_Files\SF_EDW_Products_Audit.csv;D:\Wealth_SalesForce_Data_Migration\CRM_Complaints\Audit_Files\email_exception_EDW_PsnAcct.txt'&#xA;SET @Table = CAST(( &#xA;&#xA;/*&#xA;SELECT [FName] AS 'td','',[LName] AS 'td','',&#xA;       [address] AS 'td'&#xA;&#xA;FROM  ##TempClientTable  &#xA;*/&#xA;&#xA;&#xA;select [AuditTableType] AS 'td','',[TableName] AS 'td','',[ETL_Datetime] AS 'td','', [Fail_Count] AS 'td'&#xA;FROM&#xA;(&#xA;&#xA;&#xA;select AuditTableType,TableName,ETL_Datetime,Fail_Count from&#xA;(&#xA;select AuditTableType,TableName,Fail_Count, ETL_Datetime,&#xA;RANK () OVER ( &#xA;&#x9;&#x9;ORDER BY ETL_Datetime DESC&#xA;&#x9;) date_rank  from&#xA;(&#xA;SELECT 'FINANCIAL ACCOUNTS' AuditTableType,'TGT_EDW_FIN_ACCT_AUDIT' TableName,ETL_Datetime, count(*) Fail_Count&#xA;  FROM [WEALTH_TGT].[dbo].[TGT_EDW_FIN_ACCT_AUDIT]&#xA;  where ETL_RecordStatus like '%failed%'&#xA;  group by ETL_Datetime&#xA;  ) X&#xA;  )Y&#xA;  where date_rank = 1&#xA;&#xA;&#xA;  union&#xA;&#xA;  select AuditTableType,TableName,ETL_Datetime,Fail_Count from&#xA;(&#xA;select AuditTableType,TableName,Fail_Count, ETL_Datetime,&#xA;RANK () OVER ( &#xA;&#x9;&#x9;ORDER BY ETL_Datetime DESC&#xA;&#x9;) date_rank  from&#xA;(&#xA;SELECT 'PERSON ACCOUNTS' AuditTableType,'TGT_EDW_PERSON_ACCT_AUDIT' TableName,ETL_Datetime, count(*) Fail_Count&#xA;  FROM [WEALTH_TGT].[dbo].[TGT_EDW_PERSON_ACCT_AUDIT]&#xA;  where ETL_RecordStatus like '%failed%'&#xA;  group by ETL_Datetime&#xA;&#xA;  ) X&#xA;  )Y&#xA;  where date_rank = 1&#xA;&#xA;&#xA;    union&#xA;&#xA;  select AuditTableType,TableName,ETL_Datetime,Fail_Count from&#xA;(&#xA;select AuditTableType,TableName,Fail_Count, ETL_Datetime,&#xA;RANK () OVER ( &#xA;&#x9;&#x9;ORDER BY ETL_Datetime DESC&#xA;&#x9;) date_rank  from&#xA;(&#xA;SELECT 'BUSINESS ACCOUNTS' AuditTableType,'TGT_EDW_BUSINESS_ACCT_AUDIT' TableName,ETL_Datetime, count(*) Fail_Count&#xA;  FROM [WEALTH_TGT].[dbo].[TGT_EDW_BUSINESS_ACCT_AUDIT]&#xA;  where ETL_RecordStatus like '%failed%'&#xA;  --and ETL_Datetime = max(ETL_Datetime)&#xA;  group by ETL_Datetime&#xA;  ) X&#xA;  )Y&#xA;  where date_rank = 1&#xA;&#xA;      union&#xA;  select AuditTableType,TableName,ETL_Datetime,Fail_Count from&#xA;(&#xA;select AuditTableType,TableName,Fail_Count, ETL_Datetime,&#xA;RANK () OVER ( &#xA;&#x9;&#x9;ORDER BY ETL_Datetime DESC&#xA;&#x9;) date_rank  from&#xA;(&#xA;SELECT 'PRODUCTS' AuditTableType,'TGT_EDW_PRODUCTS_AUDIT' TableName,ETL_Datetime, count(*) Fail_Count&#xA;  FROM [WEALTH_TGT].[dbo].[TGT_EDW_PRODUCTS_AUDIT]&#xA;  where ETL_RecordStatus like '%failed%'&#xA;  --and ETL_Datetime = max(ETL_Datetime)&#xA;  group by ETL_Datetime&#xA;  ) X&#xA;  )Y&#xA;  where date_rank = 1&#xA;&#xA;&#xA;&#xA;) FINAL&#xA;&#xA;&#xA;where  CONVERT(VARCHAR(10), ETL_Datetime, 111) = CONVERT(VARCHAR(10), CURRENT_TIMESTAMP, 111)&#xA;&#xA;FOR XML PATH('tr'), ELEMENTS ) AS NVARCHAR(MAX))&#xA;SET @body ='&lt;html&gt;&lt;body&gt;&lt;H3&gt;Salesforce EDW Batch Run Completed Successfully&lt;/H3&gt;&#xA;&lt;table border = 1&gt; &#xA;&lt;tr&gt;&#xA;&lt;th&gt; AuditTableType &lt;/th&gt; &lt;th&gt; TableName &lt;/th&gt; &lt;th&gt; ETL_Datetime &lt;/th&gt; &lt;th&gt; Fail_Count &lt;/th&gt; &lt;th&gt;'    SET @body = @body + @Table +'&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;'&#xA;&#xA;EXEC msdb.dbo.sp_send_dbmail&#xA;&#xA;@profile_name = 'SQLAlerts',&#xA;&#xA;@body = @body,@body_format ='HTML',&#xA;&#xA;@recipients = @emailrecipients,&#xA;&#xA;@subject = 'Salesforce EDW Batch Run Information',&#xA;@file_attachments = @attachments ;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::pSMTP_EmailRecipients"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="500" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
