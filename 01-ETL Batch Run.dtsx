      <DTS:ObjectData>
        <SendMailTask:SendMailTaskData
          SendMailTask:SMTPServer="{E91DB9B5-CCEA-4DD7-A722-A3F5C3222536}"
          SendMailTask:From="WealthCRM_SQLServer_Alerts@insigniafinancial.com.au"
          SendMailTask:To="raju.vamaraju@insigniafinancial.com.au;vimal.chandolu@insigniafinancial.com.au"
          SendMailTask:Subject="IFL PROD Salesforce EDW Data Migration has FAILED"
          SendMailTask:MessageSource="Attention: &#xA;&#xA;&#xA;&#xA;This batch has failed. &#xA;&#xA;Please check the Batch Run Table." xmlns:SendMailTask="www.microsoft.com/sqlserver/dts/tasks/sendmailtask" />
