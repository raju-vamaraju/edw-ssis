                <SQLTask:SqlTaskData
                  SQLTask:Connection="{CAEB46AA-F33A-4C72-8C4E-AC3027F4426E}"
                  SQLTask:SqlStatementSource="execute ETL_End_Batch_SP ?, 'F', 'Failed';  Raiserror(55555,20,-1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
